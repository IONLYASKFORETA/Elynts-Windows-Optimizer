<Application x:Class="Elynt.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Elynt.App.Theme"
             StartupUri="MainWindow.xaml">
    <!-- Always black: Fluent's dark theme (which also fixes the theme mode to dark, so the title bar and scroll bars
         stay dark whatever Windows uses), re-coloured to the app's palette, then the app's own styles. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
                <ResourceDictionary Source="/ElyntOptimizer;component/Theme/FluentColors.xaml" />
                <ResourceDictionary Source="/ElyntOptimizer;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <theme:PageIcon x:Key="PageIcon" />
            <theme:Caps x:Key="Caps" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
