<UserControl x:Class="Elynt.App.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <CollectionViewSource x:Key="ItemsByGroup" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <!-- Startup: every item that runs at sign-in, plus third-party scheduled tasks. Off is Task Manager's switch;
         delete is separate and needs its own confirmation. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,8">
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Turning an item off uses the same switch as Task Manager, so it's reversible and Windows agrees with it. Deleting is separate and can't be undone." />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Refresh" Padding="12,2" Click="Refresh" />
                <CheckBox Content="Tell me in the tray when an app adds itself to startup"
                          IsChecked="{Binding NotifyNewStartupItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Source={StaticResource ItemsByGroup}}" HorizontalContentAlignment="Stretch" BorderThickness="0">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="4,12,4,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                    <Grid Margin="4,6" ToolTip="{Binding Command}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Location}" Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Delete…" Padding="8,2" Margin="0,0,12,0" Click="Delete"
                                    IsEnabled="{Binding CanDelete}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}" />
                            <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                      AutomationProperties.Name="{Binding Name}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
