<!-- Per-game profiles, then installed games: what the launchers report, plus games added by their .exe. -->
<UserControl x:Class="Elynt.App.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <DockPanel DataContext="{Binding Games}" Margin="4">
        <local:ProfilesPage DockPanel.Dock="Top"
                            DataContext="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=Window}}" />
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Installed games" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Found in Steam, Epic, GOG, Battle.net, EA, Ubisoft and the Xbox app. Tweak warnings name these games."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,8" />
            <Button Content="Add a game by its .exe…" Click="AddGame" HorizontalAlignment="Left" Padding="12,4" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,6" />
            <TextBlock Text="No games found yet." Opacity="0.7"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Remove" Click="RemoveGame" Padding="8,2" VerticalAlignment="Center"
                                Visibility="{Binding CanRemove, Converter={StaticResource Visible}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
