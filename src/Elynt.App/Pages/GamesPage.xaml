<!-- Per-game profiles, games first: every game found on this PC (each marked when it has a profile), "Find a game" over
     them and adding one by its .exe. Selecting a game shows its profile editor in the detail pane. -->
<UserControl x:Class="Elynt.App.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The list, its note and the tray switch scroll together, so all stay reachable at the smallest window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Full width up to a comfortable width for the rows, then held to the left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="960" />
            </Grid.ColumnDefinitions>
            <StackPanel DataContext="{Binding Profiles}" Margin="0,0,8,24">
                <!-- "Find a game", and adding one the launchers don't know about. -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add a game by its .exe…" Click="AddGame" Margin="8,0,0,0" />
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Find a game" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,8,0,0" Text="{Binding ResultCount}" />
                <TextBlock Style="{StaticResource Text.Message}" Margin="0,8,0,0" Text="{Binding GamesMessage}" />

                <!-- A card per game: its name, where it was found and its anti-cheat, then whether it has a profile. Remove only
                     on games added by their .exe. -->
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Shown}" SelectedItem="{Binding SelectedGame}"
                         Margin="0,12,0,0" AutomationProperties.Name="Games">
                    <!-- No scroller of its own: the page scrolls, so the mouse wheel works over the list too. -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Theme.Text}" />
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,0" Text="{Binding Detail}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0" VerticalAlignment="Center"
                                            Visibility="{Binding HasProfile, Converter={StaticResource Visible}}">
                                        <TextBlock Text="Profile" Foreground="{StaticResource Theme.Text}" />
                                    </Border>
                                    <TextBlock Text="No profile" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Dim}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProfile}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Remove" Click="RemoveGame" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Visible}}" />
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Margin="10,0,0,0" Text="&#xE76C;"
                                               Foreground="{StaticResource Theme.TextDim}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,10,0,0"
                           Text="A profile holds only instant changes. They're made when the game starts and undone 15 seconds after it closes, or at the next start if the PC crashed. The first game running stays in charge; another game's profile is skipped meanwhile. Reboot-only tweaks and Defender are never part of a profile." />

                <!-- The tray-note switch, as on Settings: the words on the left, the switch on the right. -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,14,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  IsChecked="{Binding NotifyProfiles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  AutomationProperties.Name="Quiet tray notes when a profile is applied, undone or skipped" />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Theme.Text}" Margin="0,0,16,0" VerticalAlignment="Center"
                                   Text="Quiet tray notes when a profile is applied, undone or skipped" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
