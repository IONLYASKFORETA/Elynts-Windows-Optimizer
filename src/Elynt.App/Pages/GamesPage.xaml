<!-- Per-game profiles, then installed games: what the launchers report, plus games added by their .exe. -->
<UserControl x:Class="Elynt.App.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <UserControl.Resources>
        <!-- The service's answer to the last add or remove; it takes no room while there is none. -->
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The editor and the games scroll together, so both stay reachable at the smallest window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Full width up to a comfortable width for the editor's form, then held to the left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="960" />
            </Grid.ColumnDefinitions>
            <StackPanel DataContext="{Binding Games}" Margin="0,0,8,24">
                <local:ProfilesPage DataContext="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Style="{StaticResource Text.Label}" Margin="0,32,0,6" Text="INSTALLED GAMES" />
                <TextBlock Style="{StaticResource Text.Dim}"
                           Text="Found in Steam, Epic, GOG, Battle.net, EA, Ubisoft and the Xbox app. Tweak warnings name these games." />
                <Button Content="Add a game by its .exe…" Click="AddGame" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" Text="{Binding Message}" />
                <TextBlock Style="{StaticResource Text.Dim}" Margin="0,12,0,0" Text="No games found yet."
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <!-- A card per game; Remove only on games added by their .exe. -->
                <ItemsControl ItemsSource="{Binding Games}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" CornerRadius="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Theme.Text}" />
                                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,0" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove" Click="RemoveGame" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Visible}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
