<!-- Overclocking page: GPU tuning, sensors and CPU tuning, then BIOS settings read from Windows with guides for this board and CPU. -->
<UserControl x:Class="Elynt.App.Pages.OverclockingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <UserControl.Resources>
        <!-- A guide as a card that folds open: the title and a chevron, then the guide under a faint line once opened. -->
        <Style x:Key="GuideFold" TargetType="Expander">
            <!-- The header takes the keyboard focus, not the fold around it. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Theme.Text}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="8" BorderThickness="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Stroke}">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Cursor="Hand" FocusVisualStyle="{x:Null}"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Padding="16,12" CornerRadius="7" BorderThickness="1"
                                                    Background="Transparent" BorderBrush="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Chevron" Grid.Column="1" Style="{StaticResource Text.Icon}" FontSize="12"
                                                               Margin="12,0,0,0" Foreground="{StaticResource Theme.TextDim}" Text="&#xE70D;" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Theme.Hover}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Theme.TextDim}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                                    <Setter TargetName="Bg" Property="CornerRadius" Value="7,7,0,0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="Body" Padding="16,12,16,14" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Theme.Stroke}"
                                        Visibility="Collapsed">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Full width up to a comfortable reading width, then held to the left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,24">
                <local:GpuTuningPanel DataContext="{Binding Gpu}"
                                      Visibility="{Binding DataContext.IsGpuPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                <local:SensorsPanel DataContext="{Binding Sensors}"
                                    Visibility="{Binding DataContext.IsSensorsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                <local:CpuTuningPanel DataContext="{Binding Cpu}"
                                      Visibility="{Binding DataContext.IsCpuPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <!-- BIOS settings: what Windows can tell, guides for this board and CPU, and tools to test stability. -->
                <StackPanel DataContext="{Binding Bios}"
                            Visibility="{Binding DataContext.IsBiosPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,6" Text="BIOS SETTINGS" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Theme.Text}" TextWrapping="Wrap" Text="{Binding Hardware}" />
                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,12"
                               Text="The app only reads these. Changing them happens in the BIOS, with the guides below." />
                    <ItemsControl Style="{StaticResource CardRows}" ItemsSource="{Binding Readouts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Theme.Text}" TextWrapping="Wrap"
                                                       Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Dim}" Margin="0,2,0,0" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Theme.Text}" Text="{Binding State}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Text.Label}" Text="GUIDES FOR THIS PC" />
                    <ItemsControl ItemsSource="{Binding Guides}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource GuideFold}" Header="{Binding Title}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,8" Text="{Binding Summary}" />
                                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,2" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,8,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,2" FontSize="12.5">
                                                        <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                                            <Run Text="&#xE8A7;" FontFamily="{StaticResource Theme.IconFont}" FontSize="11" />
                                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Text.Label}" Text="TEST STABILITY AFTER EVERY CHANGE" />
                    <ItemsControl Style="{StaticResource CardRows}" ItemsSource="{Binding StabilityTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardRow}">
                                    <StackPanel>
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                                <Run Text="&#xE8A7;" FontFamily="{StaticResource Theme.IconFont}" FontSize="11" FontWeight="Normal" />
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Text.Dim}" Margin="0,2,0,0" Text="{Binding WhatToRun}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
