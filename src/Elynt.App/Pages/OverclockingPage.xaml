<!-- Overclocking page: GPU tuning, then BIOS settings read from Windows with guides for this board and CPU. -->
<UserControl x:Class="Elynt.App.Pages.OverclockingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
        <local:GpuTuningPanel DataContext="{Binding Gpu}"
                              Visibility="{Binding DataContext.IsGpuPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
        <local:SensorsPanel DataContext="{Binding Sensors}"
                            Visibility="{Binding DataContext.IsSensorsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
        <local:CpuTuningPanel DataContext="{Binding Cpu}"
                              Visibility="{Binding DataContext.IsCpuPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
        <StackPanel DataContext="{Binding Bios}" Margin="4"
                    Visibility="{Binding DataContext.IsBiosPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
            <TextBlock Text="BIOS settings" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Hardware}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,8" />
            <TextBlock Text="The app only reads these. Changing them happens in the BIOS, with the guides below."
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Readouts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding State, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Guides for this PC" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ItemsControl ItemsSource="{Binding Guides}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Title}" Margin="0,4">
                            <StackPanel Margin="20,4,0,8">
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Test stability after every change" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
            <ItemsControl ItemsSource="{Binding StabilityTools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock>
                                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding WhatToRun}" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
