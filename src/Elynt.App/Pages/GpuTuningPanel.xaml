<UserControl x:Class="Elynt.App.Pages.GpuTuningPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <!-- GPU tuning: sliders bounded by the driver's ranges; every change goes back after 15 s unless kept. -->
    <StackPanel Margin="4,4,4,16">
        <TextBlock Text="GPU tuning" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Every change goes back on its own after 15 seconds unless you keep it. If Windows crashes or freezes, the GPU starts on default settings next time."
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,8" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"
                   Visibility="{Binding HasNotice, Converter={StaticResource Visible}}" />

        <ItemsControl ItemsSource="{Binding Gpus}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GpuTuningItemViewModel}">
                    <Border Padding="12" Margin="0,4" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="On default settings" Opacity="0.7"
                                       Visibility="{Binding AtDefaults, Converter={StaticResource Visible}}" />

                            <!-- Live sensor values, refreshed every 2 seconds. -->
                            <ItemsControl ItemsSource="{Binding Readouts}" Margin="0,6,0,0"
                                          Visibility="{Binding HasReadouts, Converter={StaticResource Visible}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,0,16,0" Opacity="0.8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Intel requires its warning to be shown and accepted before tuning unlocks. -->
                            <Border Padding="10" Margin="0,8,0,0" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="DarkOrange"
                                    Visibility="{Binding IsLocked, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="Read this before tuning" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <Button Content="I understand the risks, unlock tuning" Command="{Binding AcceptWarning}"
                                            Padding="12,4" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Controls}" Margin="0,8,0,0"
                                          IsEnabled="{Binding IsUnlocked}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TuningSliderViewModel}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding RangeText}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Slider Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                                    TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                                                    Value="{Binding Value, Mode=TwoWay}"
                                                    AutomationProperties.Name="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Apply" Command="{Binding Apply}" Padding="12,4" Margin="0,0,8,4" />
                                <Button Content="Auto overclock" Command="{Binding AutoOverclock}" Padding="12,4" Margin="0,0,8,4"
                                        Visibility="{Binding CanAutoOverclock, Converter={StaticResource Visible}}" />
                                <Button Content="Auto undervolt" Command="{Binding AutoUndervolt}" Padding="12,4" Margin="0,0,8,4"
                                        Visibility="{Binding CanAutoUndervolt, Converter={StaticResource Visible}}" />
                                <Button Content="Reset to defaults" Command="{Binding Reset}" Padding="12,4" Margin="0,0,8,4" />
                            </WrapPanel>

                            <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowsNvidiaApp, Converter={StaticResource Visible}}">
                                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                           Text="For a one-click safe overclock, use Automatic Tuning in the NVIDIA App (System, then Performance). Use either it or the sliders here, not both: they overwrite each other." />
                                <Button Content="Open the NVIDIA App" Command="{Binding OpenNvidiaApp}" Padding="12,4" Margin="0,4,0,0" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding Countdown}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <Button Content="Keep" Command="{Binding Keep}" Padding="12,4" Margin="0,0,8,0" />
                                <Button Content="Go back now" Command="{Binding GoBack}" Padding="12,4" />
                            </StackPanel>

                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
