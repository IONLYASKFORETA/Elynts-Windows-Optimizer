<!-- Startup & Services: the startup list and the services list, one tab each. -->
<UserControl x:Class="Elynt.App.Pages.StartupAndServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <UserControl.Resources>
        <!-- Body text that takes no room while it has nothing to say (a service with no description). -->
        <Style x:Key="Optional" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A header heading: no room above it, sitting on the header row's centre line. -->
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Transparent so the rows sit on the page, as on every other page. -->
    <TabControl Background="Transparent">
        <TabItem Header="Startup">
            <!-- Startup items and third-party scheduled tasks. -->
            <local:StartupPage DataContext="{Binding Startup}" Margin="0,16,0,0" />
        </TabItem>
        <TabItem Header="Services">
            <!-- Services: every service and driver; reviewed ones editable, "Show advanced services" unlocks the rest but
                 never protected ones. A table: one row per service under a header naming its two columns. -->
            <DockPanel DataContext="{Binding ServicesPage}" Margin="0,16,0,0" Grid.IsSharedSizeScope="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Dim}" />
                    <!-- The filter, with the switch that shows every other service beside it. -->
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" Background="Transparent"
                                    ToolTip="Unlocks Disabled and services that aren't on the reviewed list. Anti-cheat, Windows Update and boot drivers stay locked.">
                            <TextBlock Text="Show advanced services" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Advanced}" AutomationProperties.Name="Show advanced services" />
                        </StackPanel>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filter services by name" />
                    </DockPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Message}" Margin="0,8,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Table.Header}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceStart" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SERVICE" Style="{StaticResource Heading}" />
                        <TextBlock Grid.Column="1" Text="START TYPE" Style="{StaticResource Heading}" Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <ListBox Style="{StaticResource Table.List}" ItemsSource="{Binding Services}" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServiceItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceStart" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Theme.Text}" />
                                    <!-- The badge as a pill, then the start type (under it when the line is full). -->
                                    <WrapPanel Margin="0,6,0,-6">
                                        <Border Style="{StaticResource Pill}">
                                            <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Theme.TextDim}" />
                                        </Border>
                                        <TextBlock Text="{Binding StartText}" Style="{StaticResource Text.Dim}" VerticalAlignment="Center" Margin="2,0,0,6" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding View.Explanation}" Style="{StaticResource Optional}" FontSize="12.5" LineHeight="18" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding RecommendationText}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{StaticResource Theme.Text}"
                                               Visibility="{Binding HasRecommendation, Converter={StaticResource Visible}}" />
                                    <!-- Why it is protected; the lock beside the controls' place says that it is. -->
                                    <TextBlock Text="{Binding View.LockReason}" Style="{StaticResource Text.Dim}" Margin="0,6,0,0"
                                               Visibility="{Binding IsProtected, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <!-- A protected service can't be changed, so it shows the lock in place of the start type and Set. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsProtected, Converter={StaticResource Visible}}">
                                        <TextBlock Style="{StaticResource Text.Lock}" Margin="0,0,8,0" />
                                        <TextBlock Text="Protected" Style="{StaticResource Text.Dim}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding NotProtected, Converter={StaticResource Visible}}">
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" Width="132"
                                                  IsEnabled="{Binding CanChange}" />
                                        <Button Content="Set" Click="SetServiceStart" Padding="12,5" Margin="6,0,0,0" IsEnabled="{Binding CanChange}" />
                                    </StackPanel>
                                    <!-- Only on a service the app changed; it stays (greyed) while that change is being undone. -->
                                    <Button Content="Undo" Click="UndoServiceChange" Padding="12,5" Margin="6,0,0,0"
                                            Visibility="{Binding View.CanUndo, Converter={StaticResource Visible}}" IsEnabled="{Binding CanUndo}"
                                            ToolTip="Puts back the whole configuration this service had before the app changed it." />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
