<!-- Repair: one row per tool, each saying up front whether it needs a restart. -->
<UserControl x:Class="Elynt.App.Pages.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
            <Button Content="Copy app log" Click="CopyAppLog" Padding="12,4" DockPanel.Dock="Left"
                    ToolTip="Copies the app's and the service's latest logs, for sending to Aden with a bug report." />
            <TextBlock x:Name="AppLogStatus" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
        </DockPanel>
        <ListBox ItemsSource="{Binding RepairTools}" SelectedItem="{Binding SelectedRepairTool}"
                 HorizontalContentAlignment="Stretch" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RepairToolItemViewModel}">
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap">
                                <Run Text="{Binding RestartBadge, Mode=OneWay}" />
                                <Run Text="{Binding View.NotAvailableReason, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Opt-in" Opacity="0.7" VerticalAlignment="Center"
                                   Visibility="{Binding IsOptIn, Converter={StaticResource Visible}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
