<!-- Drivers page: each GPU's and the chipset's installed driver, the latest from the vendor, and a silent install. -->
<UserControl x:Class="Elynt.App.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel DataContext="{Binding Drivers}" Margin="4">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Opacity="0.8"
                       Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Gpus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GpuItemViewModel}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InstalledVersion}" Opacity="0.8" Margin="0,2,0,6" />
                            <CheckBox Content="Studio driver instead of Game Ready" IsChecked="{Binding UseStudio}"
                                      IsEnabled="{Binding IsIdle}"
                                      Visibility="{Binding HasBranches, Converter={StaticResource Visible}}" />
                            <CheckBox Content="Clean install (resets the driver's own settings)" IsChecked="{Binding CleanInstall}"
                                      IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
                                      Visibility="{Binding HasCleanInstall, Converter={StaticResource Visible}}" />
                            <CheckBox Content="Lean install (display driver only: no NVIDIA App, telemetry or extras; laptops keep their power components; needs 7-Zip)"
                                      IsChecked="{Binding LeanInstall}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
                                      Visibility="{Binding CanInstallLean, Converter={StaticResource Visible}}" />
                            <CheckBox Content="Remove the old drivers first (backed up, put back if the install fails)" IsChecked="{Binding RemoveOldDrivers}"
                                      IsEnabled="{Binding IsIdle}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Check for a newer driver" Click="CheckDriver" Padding="12,4"
                                        IsEnabled="{Binding IsIdle}" />
                                <Button Content="Download and install" Click="InstallDriver" Padding="12,4" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsIdle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Visibility="{Binding HasVendorPage, Converter={StaticResource Visible}}">
                                <Hyperlink NavigateUri="{Binding VendorPage}" RequestNavigate="OpenLink">
                                    <Run Text="Open the vendor's driver page" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                       Text="Every download is checked for the vendor's signature before it runs; anything unsigned or tampered with is deleted." />

            <!-- Driver cleaning: problem drivers, pnputil clean (restorable), opt-in DDU, backups. -->
            <StackPanel DataContext="{Binding Cleaning}" Margin="0,16,0,0">
                <TextBlock Text="Drivers that stop anti-cheats" FontSize="16" FontWeight="SemiBold"
                           Visibility="{Binding HasProblemDrivers, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding ProblemDrivers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding Driver, Mode=OneWay}" /> <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource Theme.Orange}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Clean old drivers" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Vendor:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding Vendor}" MinWidth="100" IsEnabled="{Binding IsIdle}" />
                    <Button Content="Remove old drivers (backed up first)" Click="CleanDrivers" Padding="12,4" Margin="8,0,0,0"
                            IsEnabled="{Binding IsIdle}" />
                </StackPanel>
                <TextBlock Text="{Binding DduLabel}" TextWrapping="Wrap" Opacity="0.8" Margin="0,10,0,0" />
                <CheckBox Content="I understand: use DDU for a vendor switch or a broken install" IsChecked="{Binding DduAccepted}"
                          IsEnabled="{Binding IsIdle}" Margin="0,4,0,0" />
                <Button Content="Deep clean with DDU" Click="DeepCleanDrivers" Padding="12,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                        IsEnabled="{Binding DduAccepted}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />

                <TextBlock Text="Driver backups" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                           Visibility="{Binding HasBackups, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriverBackupItemViewModel}">
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Content="Restore" Click="RestoreDrivers" Padding="12,4"
                                        IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Contents}" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
