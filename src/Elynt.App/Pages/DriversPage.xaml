<!-- Drivers page: a card for each GPU and the chipset with its installed driver and a silent install, then driver cleaning. -->
<UserControl x:Class="Elynt.App.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Full width up to a comfortable reading width, then held to the left. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
            </Grid.ColumnDefinitions>
            <StackPanel DataContext="{Binding Drivers}" Margin="0,0,8,24">
                <Border Style="{StaticResource WarningBox}" Margin="0,0,0,12"
                        Visibility="{Binding HasProblem, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Problem}" />
                </Border>

                <!-- A card per GPU, then the chipset: the installed driver, the install options, Check and Install, the
                     answer, and the vendor's page when the app couldn't find or trust a download. -->
                <ItemsControl ItemsSource="{Binding Gpus}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GpuItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.H2}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,4,0,0" Text="{Binding InstalledVersion}" />

                                    <!-- Tick boxes whose text wraps, so the long options stay readable at the smallest window. -->
                                    <StackPanel Margin="0,10,0,0">
                                        <CheckBox IsChecked="{Binding UseStudio}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
                                                  AutomationProperties.Name="Studio driver instead of Game Ready"
                                                  Visibility="{Binding HasBranches, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Studio driver instead of Game Ready" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding CleanInstall}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
                                                  AutomationProperties.Name="Clean install (resets the driver's own settings)"
                                                  Visibility="{Binding HasCleanInstall, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Clean install (resets the driver's own settings)" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding LeanInstall}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
                                                  AutomationProperties.Name="Lean install (display driver only: no NVIDIA App, telemetry or extras; laptops keep their power components; needs 7-Zip)"
                                                  Visibility="{Binding CanInstallLean, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Lean install (display driver only: no NVIDIA App, telemetry or extras; laptops keep their power components; needs 7-Zip)"
                                                       TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding RemoveOldDrivers}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,0"
                                                  AutomationProperties.Name="Remove the old drivers first (backed up, put back if the install fails)">
                                            <TextBlock Text="Remove the old drivers first (backed up, put back if the install fails)" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Check for a newer driver" Click="CheckDriver" Margin="0,0,8,6" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsIdle}" />
                                        <Button Content="Download and install" Click="InstallDriver" Margin="0,0,8,6" VerticalAlignment="Center"
                                                Style="{StaticResource Button.Primary}" Padding="16,7"
                                                IsEnabled="{Binding IsIdle}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Message}" Margin="0,4,0,0" Text="{Binding Message}" />
                                    <TextBlock Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                                               Visibility="{Binding HasVendorPage, Converter={StaticResource Visible}}">
                                        <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding VendorPage}" RequestNavigate="OpenLink">
                                            <Run Text="&#xE8A7;" FontFamily="{StaticResource Theme.IconFont}" FontSize="11" />
                                            <Run Text="Open the vendor's driver page" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Text.Dim}"
                           Text="Every download is checked for the vendor's signature before it runs; anything unsigned or tampered with is deleted." />

                <!-- Driver cleaning: problem drivers, pnputil clean (restorable), opt-in DDU, backups. -->
                <StackPanel DataContext="{Binding Cleaning}">
                    <TextBlock Style="{StaticResource Text.Label}" Text="DRIVERS THAT STOP ANTI-CHEATS"
                               Visibility="{Binding HasProblemDrivers, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding ProblemDrivers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WarningBox}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Theme.Text}" TextWrapping="Wrap">
                                            <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding Driver, Mode=OneWay}" /> <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" Text="{Binding Warning}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Text.Label}" Text="CLEAN OLD DRIVERS" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource Text.Body}" Text="Vendor:" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding Vendor}" MinWidth="120" Margin="0,0,8,6"
                                          VerticalAlignment="Center" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Vendor" />
                                <Button Content="Remove old drivers (backed up first)" Click="CleanDrivers" Margin="0,0,0,6" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsIdle}" />
                            </WrapPanel>

                            <!-- DDU removes everything with no backup, so it sits in a red box and runs only once accepted. -->
                            <Border Style="{StaticResource DangerBox}" Margin="0,10,0,0" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DduLabel}" />
                                    <CheckBox IsChecked="{Binding DduAccepted}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0"
                                              AutomationProperties.Name="I understand: use DDU for a vendor switch or a broken install">
                                        <TextBlock Text="I understand: use DDU for a vendor switch or a broken install" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <Button Content="Deep clean with DDU" Click="DeepCleanDrivers" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource Button.Destructive}" Padding="16,7"
                                            IsEnabled="{Binding DduAccepted}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Text.Message}" Margin="0,10,0,0" Text="{Binding Message}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Label}" Text="DRIVER BACKUPS"
                               Visibility="{Binding HasBackups, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriverBackupItemViewModel}">
                                <Border Margin="0,0,0,6" Padding="16,12" CornerRadius="8" BorderThickness="1"
                                        Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Stroke}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Restore" Click="RestoreDrivers" Margin="12,0,0,0" VerticalAlignment="Center"
                                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Theme.Text}" TextWrapping="Wrap"
                                                       Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,0" Text="{Binding Contents}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
