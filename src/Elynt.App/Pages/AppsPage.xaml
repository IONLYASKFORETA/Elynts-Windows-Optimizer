<!-- Apps: the reviewed catalogue, a search of all of winget, and installed apps with updates and uninstalls. -->
<UserControl x:Class="Elynt.App.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <UserControl.Resources>
        <CollectionViewSource x:Key="AppsByGroup" Source="{Binding Apps}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="Catalogue">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Install ticked apps" Padding="16,4"
                                Click="InstallApps" IsEnabled="{Binding CanInstall}" />
                        <Button DockPanel.Dock="Right" Content="Load app list…" Padding="12,4" Margin="0,0,8,0"
                                Click="LoadAppList" IsEnabled="{Binding CanInstall}"
                                ToolTip="Tick every app in a list saved on this or another PC, ready to install." />
                        <Button DockPanel.Dock="Right" Content="Save ticked as app list…" Padding="12,4" Margin="0,0,8,0"
                                Click="SaveAppList"
                                ToolTip="Save the ticked apps (here and on the Search tab) to a file you can load on another PC." />
                        <CheckBox Content="Install all runtimes (Visual C++, DirectX legacy and .NET)"
                                  IsChecked="{Binding InstallAllRuntimes}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Source={StaticResource AppsByGroup}}"
                         HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="4,12,4,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsTicked}" VerticalAlignment="Center" Margin="0,0,8,0"
                                          AutomationProperties.Name="{Binding Name}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                    <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                                           MaxWidth="220" TextWrapping="Wrap" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <TabItem Header="Search winget" DataContext="{Binding AppsManager}">
            <DockPanel Margin="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="Search" Padding="16,4" Margin="8,0,0,0" Click="SearchApps" />
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search winget" KeyDown="SearchBoxKeyDown" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,8"
                           Text="Searches all of winget's community source. Apps marked Not reviewed aren't in the curated catalogue: install them only if you trust the publisher." />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Install ticked results" Padding="16,4" HorizontalAlignment="Right"
                            Click="InstallSearchResults"
                            IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="{Binding SearchStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding SearchResults}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsTicked}" VerticalAlignment="Center" Margin="0,0,8,0"
                                          AutomationProperties.Name="{Binding Name}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" />
                                        <Border Visibility="{Binding NotReviewed, Converter={StaticResource Visible}}"
                                                Background="#33FFA500" CornerRadius="3" Padding="6,0" Margin="8,0,0,0">
                                            <TextBlock Text="Not reviewed" FontSize="11" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                                           MaxWidth="220" TextWrapping="Wrap" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <TabItem Header="Installed" DataContext="{Binding AppsManager}">
            <DockPanel Margin="4">
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Content="Update all" Padding="16,4" Click="UpdateAllApps"
                            IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Padding="12,4" Margin="0,0,8,0" Click="RefreshInstalledApps" />
                    <TextBlock Text="{Binding InstalledStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding InstalledApps}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstalledAppViewModel}">
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" />
                                        <Border Visibility="{Binding NotReviewed, Converter={StaticResource Visible}}"
                                                Background="#33FFA500" CornerRadius="3" Padding="6,0" Margin="8,0,0,0">
                                            <TextBlock Text="Not reviewed" FontSize="11" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"
                                           MaxWidth="200" TextWrapping="Wrap" Margin="8,0,8,0" />
                                <Button Grid.Column="2" Content="Update" Padding="12,2" Margin="0,0,8,0" Click="UpdateApp"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource Visible}}"
                                        IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Grid.Column="3" Content="Uninstall" Padding="12,2" Click="UninstallApp"
                                        IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
