<!-- Apps: the reviewed catalogue, a search of all of winget, and installed apps with updates and uninstalls. -->
<UserControl x:Class="Elynt.App.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Elynt.App.ViewModels"
             xmlns:local="clr-namespace:Elynt.App.Pages">
    <UserControl.Resources>
        <CollectionViewSource x:Key="AppsByGroup" Source="{Binding Catalogue.Shown}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- The action bar along the bottom of a tab, under a faint divider. -->
        <Style x:Key="ActionBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Stroke}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,10,0,12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- A queue's progress and outcome, under the action bar's buttons; it takes no room while there is none. -->
        <Style x:Key="QueueStatus" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- An app's own status in its row ("Queued", "Installing… 40%", "Installed"). -->
        <Style x:Key="RowStatus" TargetType="TextBlock" BasedOn="{StaticResource Text.Dim}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- What winget says of a catalogue app (its InstalledText): orange "Update available", plain "Installed", and
             nothing while it isn't installed. -->
        <Style x:Key="InstalledPill" TargetType="Border" BasedOn="{StaticResource Pill.Warning}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpdate}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Theme.Surface2}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Stroke}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Theme.TextDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding InstalledText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Transparent so the app rows read as cards on the page, as on every other page. -->
    <TabControl x:Name="Tabs" Background="Transparent">
        <TabItem Header="Catalogue" DataContext="{Binding Catalogue}">
            <DockPanel Margin="0,16,0,0">
                <!-- The filter, and how many apps it shows just under it. -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter the catalogue" />
                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,8,0,0" Text="{Binding ResultCount}" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding InstallAllRuntimes}" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Install all runtimes (Visual C++, DirectX legacy and .NET)">
                            <TextBlock Text="Install all runtimes (Visual C++, DirectX legacy and .NET)" TextWrapping="Wrap" />
                        </CheckBox>
                        <!-- The app list buttons on the left, the install itself on the right; they fit on one line at the smallest window. -->
                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                            <!-- Off while the service is busy or gone (this holder) and while nothing would be installed (the button). -->
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                    IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding InstallText}" Padding="16,7"
                                        Click="InstallApps" IsEnabled="{Binding HasAppsToInstall}" />
                            </Border>
                            <Button Content="Save ticked as app list…" Margin="0,0,8,0"
                                    Click="SaveAppList"
                                    ToolTip="Save the ticked apps (here and on the Search tab) to a file you can load on another PC." />
                            <Button Content="Load app list…" Margin="0,0,8,0"
                                    Click="LoadAppList" IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Tick every app in a list saved on this or another PC, ready to install." />
                        </DockPanel>
                        <TextBlock Style="{StaticResource QueueStatus}" Text="{Binding DataContext.InstallStatus, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Border>
                <!-- Pixel scrolling: with groups, item scrolling would jump a whole group at a time. -->
                <ListBox x:Name="CatalogueList" Style="{StaticResource CardList}" ItemsSource="{Binding Source={StaticResource AppsByGroup}}"
                         SelectedItem="{Binding Selected}" IsSynchronizedWithCurrentItem="False" ScrollViewer.CanContentScroll="False">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Name, Converter={StaticResource Caps}}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsTicked}" VerticalAlignment="Center" Margin="0,0,6,0"
                                          AutomationProperties.Name="{Binding Name}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- The name, and the Installed or Update available pill beside it (under it when the name fills the line). -->
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource RowName}" Margin="0,0,8,0" Text="{Binding Name}" />
                                        <Border Style="{StaticResource InstalledPill}">
                                            <TextBlock Text="{Binding InstalledText}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,0" Text="{Binding Description}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource RowStatus}" MaxWidth="220" Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <TabItem Header="Search winget" DataContext="{Binding AppsManager}">
            <DockPanel Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Dim}" Margin="0,0,0,10"
                           Text="Searches all of winget's community source. Apps marked Not reviewed aren't in the curated catalogue: install them only if you trust the publisher." />
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Click="SearchApps" />
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search all of winget" KeyDown="SearchBoxKeyDown" />
                </DockPanel>
                <!-- What the search found, just under the box; it takes no room before the first search. -->
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Message}" Margin="0,8,0,0" Text="{Binding SearchStatus}" />
                <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                    <StackPanel>
                        <!-- Off while the service is busy or gone (this holder) and while no result is ticked (the button). -->
                        <Border HorizontalAlignment="Right"
                                IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Style="{StaticResource Button.Primary}" Content="{Binding ResultsInstallText}" Padding="16,7"
                                    Click="InstallSearchResults" IsEnabled="{Binding HasResultsToInstall}" />
                        </Border>
                        <TextBlock Style="{StaticResource QueueStatus}" Text="{Binding ResultsQueueStatus}" />
                    </StackPanel>
                </Border>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding SearchResults}" Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsTicked}" VerticalAlignment="Center" Margin="0,0,6,0"
                                          AutomationProperties.Name="{Binding Name}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- The name, and the Not reviewed pill beside it (under it when the name fills the line). -->
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource RowName}" Margin="0,0,8,0" Text="{Binding Name}" />
                                        <Border Style="{StaticResource Pill.Warning}" Margin="0" VerticalAlignment="Center"
                                                Visibility="{Binding NotReviewed, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Not reviewed" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,0" Text="{Binding Details}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource RowStatus}" MaxWidth="220" Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <TabItem Header="Installed" DataContext="{Binding AppsManager}">
            <DockPanel Margin="0,16,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Update all" Padding="16,7"
                            VerticalAlignment="Center" Click="UpdateAllApps"
                            IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Margin="0,0,8,0" Click="RefreshInstalledApps" />
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding InstalledStatus}" />
                </DockPanel>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding InstalledApps}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InstalledAppViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource RowName}" Margin="0,0,8,0" Text="{Binding Name}" />
                                        <Border Style="{StaticResource Pill.Warning}" Margin="0" VerticalAlignment="Center"
                                                Visibility="{Binding NotReviewed, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Not reviewed" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Dim}" Margin="0,3,0,0" Text="{Binding Details}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource RowStatus}" MaxWidth="180" Text="{Binding Status}" />
                                <Button Grid.Column="2" Content="Update" Margin="12,0,0,0" Click="UpdateApp"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource Visible}}"
                                        IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <!-- Plain, so a long list isn't a column of red; the confirmation draws the uninstall itself in red. -->
                                <Button Grid.Column="3" Content="Uninstall" Margin="8,0,0,0" VerticalAlignment="Center" Click="UninstallApp"
                                        IsEnabled="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
