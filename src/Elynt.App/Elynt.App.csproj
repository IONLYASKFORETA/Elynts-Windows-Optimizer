<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app window. Runs without admin rights and never changes the system itself: every change is a
       command to the service over the pipe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Elynt.App</RootNamespace>
    <AssemblyName>ElyntOptimizer</AssemblyName>
    <AssemblyTitle>Elynt's Windows Optimizer</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elynt.Core\Elynt.Core.csproj" />
  </ItemGroup>

</Project>
