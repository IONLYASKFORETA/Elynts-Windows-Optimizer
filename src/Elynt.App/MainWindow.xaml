<Window x:Class="Elynt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Elynt.App.ViewModels"
        xmlns:pages="clr-namespace:Elynt.App.Pages"
        xmlns:theme="clr-namespace:Elynt.App.Theme"
        Title="Elynt's Windows Optimizer"
        Icon="/ElyntOptimizer;component/Assets/elynt.ico"
        Width="1600" Height="1000" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Theme.Bg}">
    <Window.Resources>
        <!-- When the window is narrow (IsCompact) the sidebar folds to its icons: these show a part only in one mode. -->
        <Style x:Key="WideOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The sidebar's grouped pages, each group under its header (Sidebar says which page is in which group). -->
        <theme:SidebarGroupHeader x:Key="SidebarGroupHeader" />
        <CollectionViewSource x:Key="GroupedPages" Source="{x:Static vm:Sidebar.GroupedPages}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription Converter="{StaticResource SidebarGroupHeader}" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- A sidebar entry: the page's icon and name. Folded, only the icon shows, and the name shows on hover. -->
        <DataTemplate x:Key="NavEntry">
            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding}"
                        ToolTipService.IsEnabled="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Converter={StaticResource PageIcon}}" FontSize="15" Width="22" />
                <TextBlock Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center" Text="{Binding}" Style="{StaticResource WideOnly}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <!-- Layout A: the sidebar, the page, and the detail pane on the right when something is selected. -->
    <Grid Background="{StaticResource Theme.Bg}" TextElement.Foreground="{StaticResource Theme.Text}"
          d:DataContext="{d:DesignInstance vm:MainViewModel}"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- The sidebar: 232 wide, or 72 with only its icons when the window is narrow (set in code). -->
            <ColumnDefinition x:Name="SidebarColumn" Width="232" />
            <ColumnDefinition Width="*" />
            <!-- The detail pane; it collapses on pages with nothing selected to describe. -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The accent strip along the top. -->
        <Border Grid.ColumnSpan="3" Background="{DynamicResource Theme.AccentWave}" />

        <!-- Sidebar: the app mark, the search, the grouped pages, then Undo history and Settings and a footer with the
             connection and updates. Drawn over the page, so the search's results can drop down past its edge. -->
        <Border Grid.Row="1" Panel.ZIndex="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Stroke}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="21,22,0,18">
                    <!-- The app's mark, as on its icon. -->
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Theme.Red}">
                        <TextBlock Text="E" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center" Style="{StaticResource WideOnly}">
                        <TextBlock Text="ELYNT'S" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Theme.TextFaint}" />
                        <TextBlock Text="Windows Optimizer" FontSize="13.5" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- App-wide search: wide, the box itself; folded, a button that opens the box over the page. Above the
                     pages, so its results draw over them. -->
                <StackPanel DockPanel.Dock="Top" Panel.ZIndex="1" Visibility="{Binding ShowsPages, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource WideOnly}" Margin="12,0,12,10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" FontSize="13" Padding="8,0"
                                 Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Find a tweak, tool or app"
                                 PreviewKeyDown="SearchBoxKeyDown" GotKeyboardFocus="SearchBoxFocused" />
                    </Border>
                    <Border Style="{StaticResource CompactOnly}" Margin="10,0,10,10">
                        <Button x:Name="SearchButton" Click="OpenSearch" Padding="0,8" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Find a tweak, tool or app" ToolTip="Find a tweak, tool or app">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE721;" />
                        </Button>
                    </Border>
                    <!-- The results drop down from here: a canvas takes no room and lets them draw past the sidebar. -->
                    <Canvas Height="0">
                        <Border x:Name="SearchFlyout" Canvas.Left="10" Width="360" MaxHeight="380" Padding="6" CornerRadius="8"
                                Background="{StaticResource Theme.Surface2}" BorderBrush="{StaticResource Theme.StrokeStrong}" BorderThickness="1"
                                Visibility="{Binding Search.IsOpen, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <!-- Folded, the sidebar has no room for the box, so it opens here. -->
                                <Border DockPanel.Dock="Top" Style="{StaticResource CompactOnly}" Margin="4,4,4,6">
                                    <TextBox x:Name="CompactSearchBox" Style="{StaticResource SearchBox}" FontSize="13"
                                             Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Find a tweak, tool or app" PreviewKeyDown="SearchBoxKeyDown" />
                                </Border>
                                <!-- Why there is nothing to show; it takes no room otherwise. -->
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Message}" Margin="10,6" Text="{Binding Search.Message}" />
                                <!-- Best match first: the page's icon, the name, then the page and the summary on one line. -->
                                <ListBox x:Name="SearchResults" ItemsSource="{Binding Search.Results}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Search results"
                                         KeyDown="SearchResultsKeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ChooseResult" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="15" Width="22" Margin="0,2,0,0"
                                                           VerticalAlignment="Top" Text="{Binding Page, Converter={StaticResource PageIcon}}" />
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock FontSize="13.5" Foreground="{StaticResource Theme.Text}" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Theme.TextDim}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Canvas>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" CornerRadius="8" Background="{StaticResource Theme.Surface2}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="14" />
                            <Setter Property="Padding" Value="12,10" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Margin" Value="10,14" />
                                    <Setter Property="Padding" Value="0,10" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- Folded, the status is the dot alone, and its text shows on hover. -->
                        <DockPanel ToolTip="{Binding Status}"
                                   ToolTipService.IsEnabled="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Theme.Good}" />
                                        <Setter Property="DockPanel.Dock" Value="Left" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource Theme.Red}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="DockPanel.Dock" Value="Top" />
                                                <Setter Property="Margin" Value="0,2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="9,0,0,0" FontSize="11.5" Foreground="{StaticResource Theme.TextDim}" TextWrapping="Wrap"
                                       Text="{Binding Status}" Style="{StaticResource WideOnly}" />
                        </DockPanel>
                        <!-- Folded, the buttons show an icon and name themselves on hover. -->
                        <Button Click="Retry" Margin="0,10,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Retry"
                                Visibility="{Binding CanRetry, Converter={StaticResource Visible}}" ToolTip="Retry"
                                ToolTipService.IsEnabled="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid>
                                <TextBlock Text="Retry" Style="{StaticResource WideOnly}" />
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Theme.IconFont}" FontSize="14" Style="{StaticResource CompactOnly}" />
                            </Grid>
                        </Button>
                        <Button Click="RestartIntoUpdate" Margin="0,10,0,0" Padding="10,7" HorizontalAlignment="Stretch"
                                Style="{StaticResource Button.Primary}"
                                Visibility="{Binding HasUpdateReady, Converter={StaticResource Visible}}"
                                ToolTipService.IsEnabled="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="Restart to update to" /> <Run Text="{Binding UpdateReady, Mode=OneWay}" />
                                </TextBlock>
                            </Button.ToolTip>
                            <Grid>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource WideOnly}">
                                    <Run Text="Restart to update to" /> <Run Text="{Binding UpdateReady, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource Theme.IconFont}" FontSize="14" Style="{StaticResource CompactOnly}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Undo history and Settings, pinned under the groups. -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Theme.Stroke}" BorderThickness="0,1,0,0" Padding="0,6,0,0"
                        Visibility="{Binding ShowsPages, Converter={StaticResource Visible}}">
                    <ListBox ItemsSource="{x:Static vm:Sidebar.FooterPages}" SelectedItem="{Binding SelectedFooterPage}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             ItemTemplate="{StaticResource NavEntry}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Undo history and Settings" />
                </Border>

                <!-- Home, then the PLAY, WINDOWS and TOOLS groups. It scrolls when the window is too short for them. -->
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedPages}}" SelectedItem="{Binding SelectedGroupedPage}"
                         IsSynchronizedWithCurrentItem="False" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ItemTemplate="{StaticResource NavEntry}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         AutomationProperties.Name="Pages" Visibility="{Binding ShowsPages, Converter={StaticResource Visible}}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <!-- Wide, the group's small header; folded, a thin line. Home's group has neither. -->
                                <DataTemplate>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border Style="{StaticResource WideOnly}">
                                            <TextBlock Style="{StaticResource Text.Label}" Margin="24,14,0,4" Text="{Binding Name}" />
                                        </Border>
                                        <Border Style="{StaticResource CompactOnly}" Height="1" Margin="16,6" Background="{StaticResource Theme.Stroke}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The current page. Each page is its own view under Pages; the section pages share one cell and each shows only on its own page. -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="32,26,24,0" Visibility="{Binding IsSectionPage, Converter={StaticResource Visible}}">
            <!-- The page's name and a one-line summary: how many tweaks are on, or what the page is for. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <TextBlock Style="{StaticResource Text.H1}" Text="{Binding SelectedPage}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding PageSummary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Dim}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <pages:WindowsUpdatePanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                      Visibility="{Binding IsWindowsUpdatePage, Converter={StaticResource Visible}}" />
            <Grid>
                <pages:HomePage Visibility="{Binding IsHomePage, Converter={StaticResource Visible}}" />
                <pages:AppsPage Visibility="{Binding IsAppsPage, Converter={StaticResource Visible}}" />
                <pages:RepairPage Visibility="{Binding IsRepairPage, Converter={StaticResource Visible}}" />
                <pages:StartupAndServicesPage Visibility="{Binding IsStartupPage, Converter={StaticResource Visible}}" />
                <DockPanel Visibility="{Binding IsTweakPage, Converter={StaticResource Visible}}">
                    <pages:CleanupPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                        Visibility="{Binding IsCleanupPage, Converter={StaticResource Visible}}" />
                    <pages:TweakList />
                </DockPanel>
                <TextBlock Text="Nothing here yet. This section arrives in a later build." Style="{StaticResource Text.Dim}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <pages:DriversPage Visibility="{Binding IsDriversPage, Converter={StaticResource Visible}}" />
                <pages:GamesPage Visibility="{Binding IsGamesPage, Converter={StaticResource Visible}}" />
                <pages:OverclockingPage Visibility="{Binding IsOverclockingPage, Converter={StaticResource Visible}}" />
                <pages:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource Visible}}" />
            </Grid>
        </DockPanel>

        <!-- In place of the sections when the service refused this account, which isn't an administrator account:
             the service's own words, held to a reading width. -->
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="32,26,24,0" MaxWidth="760" HorizontalAlignment="Left"
                    Visibility="{Binding IsRefused, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Text.H1}" Text="Administrator accounts only" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,12,0,0" Text="{Binding Refusal}" />
        </StackPanel>

        <!-- The Undo history draws its own title and summary, in the same place, with Restore everything beside them. -->
        <pages:HistoryPage Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="32,26,24,0"
                           Visibility="{Binding IsHistoryPage, Converter={StaticResource Visible}}" />

        <!-- 400 wide, or 320 when the window is narrow (set in code). -->
        <pages:DetailPane x:Name="Detail" Grid.Row="1" Grid.Column="2" Width="400" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
    </Grid>
</Window>
