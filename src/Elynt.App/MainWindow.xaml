<Window x:Class="Elynt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Elynt.App.ViewModels"
        xmlns:pages="clr-namespace:Elynt.App.Pages"
        Title="Elynt's Windows Optimizer"
        Width="1600" Height="1000" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Theme.Bg}">
    <!-- Layout A: the sidebar, the page, and the detail pane on the right when something is selected. -->
    <Grid Background="{StaticResource Theme.Bg}" TextElement.Foreground="{StaticResource Theme.Text}"
          d:DataContext="{d:DesignInstance vm:MainViewModel}"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
            <!-- The detail pane; it collapses on pages with nothing selected to describe. -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The accent strip along the top. -->
        <Border Grid.ColumnSpan="3" Background="{DynamicResource Theme.AccentWave}" />

        <!-- Sidebar: the app mark, the pages, and a footer with the connection and updates. -->
        <Border Grid.Row="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Stroke}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,18">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.AccentWave}">
                        <TextBlock Text="E" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ELYNT'S" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Theme.TextFaint}" />
                        <TextBlock Text="Windows Optimizer" FontSize="13.5" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="14" Padding="12,10" CornerRadius="8" Background="{StaticResource Theme.Surface2}">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,4,0,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Theme.Good}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource Theme.Red}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="9,0,0,0" FontSize="11.5" Foreground="{StaticResource Theme.TextDim}" TextWrapping="Wrap"
                                       Text="{Binding Status}" />
                        </DockPanel>
                        <Button Content="Retry" Click="Retry" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                Visibility="{Binding IsDisconnected, Converter={StaticResource Visible}}" />
                        <Button Click="RestartIntoUpdate" Margin="0,10,0,0" Padding="10,7" HorizontalAlignment="Stretch"
                                Style="{StaticResource Button.Primary}"
                                Visibility="{Binding HasUpdateReady, Converter={StaticResource Visible}}">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">
                                <Run Text="Restart to update to" /> <Run Text="{Binding UpdateReady, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Pages">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Converter={StaticResource PageIcon}}" FontSize="15" Width="22" />
                                <TextBlock Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center" Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- The current page. Each page is its own view under Pages; the section pages share one cell and each shows only on its own page. -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="32,26,24,0" Visibility="{Binding IsSectionPage, Converter={StaticResource Visible}}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.H1}" Text="{Binding SelectedPage}" Margin="0,0,0,18" />
            <pages:WindowsUpdatePanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                      Visibility="{Binding IsWindowsUpdatePage, Converter={StaticResource Visible}}" />
            <Grid>
                <pages:AppsPage Visibility="{Binding IsAppsPage, Converter={StaticResource Visible}}" />
                <pages:RepairPage Visibility="{Binding IsRepairPage, Converter={StaticResource Visible}}" />
                <pages:StartupAndServicesPage Visibility="{Binding IsStartupPage, Converter={StaticResource Visible}}" />
                <DockPanel Visibility="{Binding IsTweakPage, Converter={StaticResource Visible}}">
                    <pages:CleanupPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                        Visibility="{Binding IsCleanupPage, Converter={StaticResource Visible}}" />
                    <pages:TweakList />
                </DockPanel>
                <TextBlock Text="Nothing here yet. This section arrives in a later build." Style="{StaticResource Text.Dim}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <pages:DriversPage Visibility="{Binding IsDriversPage, Converter={StaticResource Visible}}" />
                <pages:GamesPage Visibility="{Binding IsGamesPage, Converter={StaticResource Visible}}" />
                <pages:OverclockingPage Visibility="{Binding IsOverclockingPage, Converter={StaticResource Visible}}" />
                <pages:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource Visible}}" />
            </Grid>
        </DockPanel>

        <pages:HistoryPage Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="24,18,16,0"
                           Visibility="{Binding IsHistoryPage, Converter={StaticResource Visible}}" />

        <pages:DetailPane Grid.Row="1" Grid.Column="2" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
    </Grid>
</Window>
