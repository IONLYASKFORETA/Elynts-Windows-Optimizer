<Window x:Class="Elynt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Elynt.App.ViewModels"
        xmlns:pages="clr-namespace:Elynt.App.Pages"
        Title="Elynt's Windows Optimizer"
        Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid d:DataContext="{d:DesignInstance vm:MainViewModel}"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <!-- The detail pane; it collapses on pages with nothing selected to describe. -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: sections, then per-game profiles and the undo history. -->
        <DockPanel Grid.Column="0" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="Elynt's Optimizer" FontSize="18" FontWeight="SemiBold" Margin="8,4,8,12" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" />
        </DockPanel>

        <!-- The current page. Each page is its own view under Pages; the section pages share one cell and each shows only on its own page. -->
        <DockPanel Grid.Column="1" Margin="8" Visibility="{Binding IsSectionPage, Converter={StaticResource Visible}}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPage}" FontSize="22" FontWeight="SemiBold" Margin="4,4,4,12" />
            <pages:WindowsUpdatePanel DockPanel.Dock="Top" Margin="4,0,4,12"
                                      Visibility="{Binding IsWindowsUpdatePage, Converter={StaticResource Visible}}" />
            <Grid>
                <pages:AppsPage Visibility="{Binding IsAppsPage, Converter={StaticResource Visible}}" />
                <pages:RepairPage Visibility="{Binding IsRepairPage, Converter={StaticResource Visible}}" />
                <pages:StartupAndServicesPage Visibility="{Binding IsStartupPage, Converter={StaticResource Visible}}" />
                <DockPanel Visibility="{Binding IsTweakPage, Converter={StaticResource Visible}}">
                    <pages:CleanupPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                        Visibility="{Binding IsCleanupPage, Converter={StaticResource Visible}}" />
                    <pages:TweakList />
                </DockPanel>
                <TextBlock Text="Nothing here yet. This section arrives in a later build."
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"
                           Opacity="0.7" Margin="8" TextWrapping="Wrap" />
                <pages:DriversPage Visibility="{Binding IsDriversPage, Converter={StaticResource Visible}}" />
                <pages:GamesPage Visibility="{Binding IsGamesPage, Converter={StaticResource Visible}}" />
                <pages:OverclockingPage Visibility="{Binding IsOverclockingPage, Converter={StaticResource Visible}}" />
            </Grid>
        </DockPanel>

        <pages:HistoryPage Grid.Column="1" Grid.ColumnSpan="2" Visibility="{Binding IsHistoryPage, Converter={StaticResource Visible}}" />

        <pages:DetailPane Grid.Column="2" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />

        <!-- Connection status. -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="16,4,16,10">
            <!-- Updates: the channel, and a restart button once a newer build has downloaded. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Retry" Click="Retry" Padding="16,4" Margin="0,0,16,0"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource Visible}}" />
                <Button Click="RestartIntoUpdate" Padding="16,4" Margin="0,0,16,0"
                        Visibility="{Binding HasUpdateReady, Converter={StaticResource Visible}}">
                    <TextBlock>
                        <Run Text="Restart to update to" /> <Run Text="{Binding UpdateReady, Mode=OneWay}" />
                    </TextBlock>
                </Button>
                <TextBlock Text="Updates:" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" MinWidth="90"
                          AutomationProperties.Name="Update channel" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
        </DockPanel>
    </Grid>
</Window>
