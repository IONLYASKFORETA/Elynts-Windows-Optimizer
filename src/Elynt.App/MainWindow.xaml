<Window x:Class="Elynt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Elynt.App.ViewModels"
        Title="Elynt's Windows Optimizer"
        Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid d:DataContext="{d:DesignInstance vm:MainViewModel}"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: sections, then per-game profiles and the undo history. -->
        <DockPanel Grid.Column="0" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="Elynt's Optimizer" FontSize="18" FontWeight="SemiBold" Margin="8,4,8,12" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" />
        </DockPanel>

        <!-- Tweak list: one switch per tweak; flipping it applies straight away. -->
        <DockPanel Grid.Column="1" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPage}" FontSize="22" FontWeight="SemiBold" Margin="4,4,4,12" />
            <Grid>
                <!-- Repair: one row per tool, each saying up front whether it needs a restart. -->
                <DockPanel Visibility="{Binding IsRepairPage, Converter={StaticResource Visible}}">
                    <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <Button Content="Copy app log" Click="CopyAppLog" Padding="12,4" DockPanel.Dock="Left"
                                ToolTip="Copies the app's and the service's latest logs, for sending to Aden with a bug report." />
                        <TextBlock x:Name="AppLogStatus" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding RepairTools}" SelectedItem="{Binding SelectedRepairTool}"
                             HorizontalContentAlignment="Stretch" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairToolItemViewModel}">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{Binding RestartBadge, Mode=OneWay}" />
                                            <Run Text="{Binding View.NotAvailableReason, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Opt-in" Opacity="0.7" VerticalAlignment="Center"
                                               Visibility="{Binding IsOptIn, Converter={StaticResource Visible}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ListBox ItemsSource="{Binding Tweaks}" SelectedItem="{Binding SelectedTweak}"
                         Visibility="{Binding IsTweakPage, Converter={StaticResource Visible}}"
                         HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TierText}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                              AutomationProperties.Name="{Binding Name}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Nothing here yet. This section arrives in a later build."
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"
                           Opacity="0.7" Margin="8" TextWrapping="Wrap" />
            </Grid>
        </DockPanel>

        <!-- Detail pane: what the selected tweak does, the evidence, the exact change and how to undo it. -->
        <Border Grid.Column="2" Margin="8" Padding="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                <!-- Repair detail: restart need before running, live progress, the summary and the log. -->
                <StackPanel Visibility="{Binding HasRepairSelection, Converter={StaticResource Visible}}"
                            DataContext="{Binding SelectedRepairTool}">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding View.RestartText}" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <TextBlock Text="What it does" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.WhatItDoes}" TextWrapping="Wrap" />

                    <TextBlock Text="Opt-in: read this first" FontWeight="SemiBold" Margin="0,16,0,4"
                               Visibility="{Binding IsOptIn, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding View.Confirmation}" TextWrapping="Wrap"
                               Visibility="{Binding IsOptIn, Converter={StaticResource Visible}}" />

                    <TextBlock Text="Exactly what it runs" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding View.ExactCommands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding View.NotAvailableReason}" Margin="0,16,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Button Content="Run" Click="RunRepair" IsEnabled="{Binding CanRun}" HorizontalAlignment="Left"
                            Padding="24,4" Margin="0,16,0,0" />

                    <TextBlock Text="{Binding StepText}" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />

                    <TextBlock Text="{Binding Result.Summary}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasResult, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Fix at next restart" Click="RunFollowUp" Padding="12,4" Margin="0,0,8,0"
                                Visibility="{Binding HasFollowUp, Converter={StaticResource Visible}}" />
                        <Button Content="Copy log" Click="CopyRepairLog" Padding="12,4"
                                Visibility="{Binding HasLog, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Result.LogLocation, StringFormat=Saved to {0}}" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" />

                    <TextBlock Text="Output" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Output}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"
                            DataContext="{Binding SelectedTweak}">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Opacity="0.7">
                        <Run Text="Evidence:" /> <Run Text="{Binding TierText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                    <TextBlock Text="What it does" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.WhatItDoes}" TextWrapping="Wrap" />

                    <TextBlock Text="Evidence" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.Evidence}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding View.Sources}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Exact change" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding View.ExactChange}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Undo" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.Undo}" TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Connection status. -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="16,4,16,10">
            <Button DockPanel.Dock="Right" Content="Retry" Click="Retry" Padding="16,4"
                    Visibility="{Binding IsDisconnected, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
        </DockPanel>
    </Grid>
</Window>
