<Window x:Class="Elynt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Elynt.App.ViewModels"
        Title="Elynt's Windows Optimizer"
        Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid d:DataContext="{d:DesignInstance vm:MainViewModel}"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: sections, then per-game profiles and the undo history. -->
        <DockPanel Grid.Column="0" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="Elynt's Optimizer" FontSize="18" FontWeight="SemiBold" Margin="8,4,8,12" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" />
        </DockPanel>

        <!-- Tweak list: one switch per tweak; flipping it applies straight away. -->
        <DockPanel Grid.Column="1" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedPage}" FontSize="22" FontWeight="SemiBold" Margin="4,4,4,12" />
            <Grid>
                <ListBox ItemsSource="{Binding Tweaks}" SelectedItem="{Binding SelectedTweak}"
                         HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LabelLine}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                              AutomationProperties.Name="{Binding Name}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Nothing here yet. This section arrives in a later build."
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"
                           Opacity="0.7" Margin="8" TextWrapping="Wrap" />

                <!-- Drivers page: each GPU's installed driver, the latest from the vendor, and a silent install. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDriversPage, Converter={StaticResource Visible}}">
                    <StackPanel DataContext="{Binding Drivers}" Margin="4">
                        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Opacity="0.8"
                                   Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GpuItemViewModel}">
                                    <StackPanel Margin="0,4,0,16">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding InstalledVersion}" Opacity="0.8" Margin="0,2,0,6" />
                                        <CheckBox Content="Studio driver instead of Game Ready" IsChecked="{Binding UseStudio}"
                                                  IsEnabled="{Binding IsIdle}"
                                                  Visibility="{Binding HasBranches, Converter={StaticResource Visible}}" />
                                        <CheckBox Content="Clean install (resets the driver's own settings)" IsChecked="{Binding CleanInstall}"
                                                  IsEnabled="{Binding IsIdle}" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Check for a newer driver" Click="CheckDriver" Padding="12,4"
                                                    IsEnabled="{Binding IsIdle}" />
                                            <Button Content="Download and install" Click="InstallDriver" Padding="12,4" Margin="8,0,0,0"
                                                    IsEnabled="{Binding IsIdle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0" Visibility="{Binding HasVendorPage, Converter={StaticResource Visible}}">
                                            <Hyperlink NavigateUri="{Binding VendorPage}" RequestNavigate="OpenLink">
                                                <Run Text="Open the vendor's driver page" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                                   Text="Every download is checked for the vendor's signature before it runs; anything unsigned or tampered with is deleted." />
                    </StackPanel>
                </ScrollViewer>

                <!-- BIOS page: settings only the BIOS can change, read from Windows, with guides for this board and CPU. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsBiosPage, Converter={StaticResource Visible}}">
                    <StackPanel DataContext="{Binding Bios}" Margin="4">
                        <TextBlock Text="BIOS settings" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Hardware}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <TextBlock Text="The app only reads these. Changing them happens in the BIOS, with the guides below."
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Readouts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding State, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Guides for this PC" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Guides}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Title}" Margin="0,4">
                                        <StackPanel Margin="20,4,0,8">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                                                            <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Test stability after every change" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding StabilityTools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock>
                                            <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{Binding WhatToRun}" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- Detail pane: what the selected tweak does, the evidence, the exact change and how to undo it. -->
        <Border Grid.Column="2" Margin="8" Padding="16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"
                            DataContext="{Binding SelectedTweak}">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Opacity="0.7">
                        <Run Text="Evidence:" /> <Run Text="{Binding TierText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Opacity="0.7">
                        <Run Text="Undo:" /> <Run Text="{Binding ReversibilityText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Opacity="0.7" TextWrapping="Wrap">
                        <Run Text="Risks:" /> <Run Text="{Binding RiskText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Opacity="0.7">
                        <Run Text="State:" /> <Run Text="{Binding StateText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding NotApplicableReason}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsNotApplicable, Converter={StaticResource Visible}}" />
                    <TextBlock Text="Restart the PC for this change to take effect." Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding PendingReboot, Converter={StaticResource Visible}}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkRed"
                               Visibility="{Binding IsDestructive, Converter={StaticResource Visible}}">
                        <Run Text="Can't be undone:" FontWeight="SemiBold" /> <Run Text="{Binding View.DestructiveWarning, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding HasAntiCheatWarnings, Converter={StaticResource Visible}}">
                        <TextBlock Text="Anti-cheat warning (you can still turn it on)" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding AntiCheatWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                    <TextBlock Text="What it does" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.WhatItDoes}" TextWrapping="Wrap" />

                    <TextBlock Text="Evidence" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.Evidence}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding View.Sources}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenLink">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Exact change" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding View.ExactChange}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Undo" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding View.Undo}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Connection status. -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="16,4,16,10">
            <Button DockPanel.Dock="Right" Content="Retry" Click="Retry" Padding="16,4"
                    Visibility="{Binding IsDisconnected, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
        </DockPanel>
    </Grid>
</Window>
