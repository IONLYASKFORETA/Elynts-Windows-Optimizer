<!-- The app's one dialog, in place of Windows' message boxes: a title, the message (scrolling when long) and the
     buttons, on a borderless surface with a thin edge. The buttons are made in code from a Confirmation. -->
<Window x:Class="Elynt.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{StaticResource Theme.Surface}">
    <Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Stroke}" BorderThickness="1"
            TextElement.Foreground="{StaticResource Theme.Text}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" />
            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" />
            </ScrollViewer>
            <StackPanel x:Name="Buttons" Grid.Row="2" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
