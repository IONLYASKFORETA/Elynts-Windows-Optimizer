<!-- PROTOTYPE, throwaway. Layout B: sections as tabs across the top, one centred column of cards below, and a
     tweak's details opening inside its own card instead of in a side pane. -->
<UserControl x:Class="Elynt.App.Prototype.VariantB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ElyntOptimizer;component/Prototype/BlackRed.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A tab: icon over a short label, underlined with the wave when selected. -->
            <Style x:Key="B.Tab" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource Proto.TextDim}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent">
                                <Border x:Name="Bg" Margin="2,4,2,6" CornerRadius="7" />
                                <ContentPresenter Margin="4,10,4,12" HorizontalAlignment="Center" />
                                <Border x:Name="Line" Height="3" VerticalAlignment="Bottom" Margin="10,0" CornerRadius="1.5"
                                        Background="{DynamicResource Proto.AccentWave}" Visibility="Hidden" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Proto.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource Proto.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A tweak card. Selecting it opens its details underneath, inside the same card. -->
            <Style x:Key="B.Card" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Margin="0,0,0,10">
                                <Border x:Name="Card" Padding="22,16" CornerRadius="12" Background="{StaticResource Proto.Surface}"
                                        BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" Margin="0,14" CornerRadius="1.5"
                                        Background="{DynamicResource Proto.AccentWave}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#FF3A3A44" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#88E5162D" />
                                    <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Proto.Bg}" TextElement.Foreground="{StaticResource Proto.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Proto.AccentWave}" />

        <!-- Header: name, status and the section tabs. -->
        <Border Grid.Row="1" Background="{StaticResource Proto.Surface}" BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="24,14,24,0">
                    <Border DockPanel.Dock="Right" Padding="12,6" CornerRadius="14" Background="{StaticResource Proto.Surface2}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF22C55E" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Proto.TextDim}" Text="{Binding Model.Status}"
                                       MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Proto.AccentWave}">
                            <TextBlock Text="E" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Elynt's Windows Optimizer" />
                    </StackPanel>
                </DockPanel>

                <ListBox Margin="14,6,14,0" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent"
                         BorderThickness="0" ItemContainerStyle="{StaticResource B.Tab}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Proto.Icon}" FontSize="17" HorizontalAlignment="Center" Text="{Binding Glyph}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Page}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Home. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHome, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="900" Margin="28,26,28,32">
                <!-- The banner: how many tweaks are on, big, in the wave. -->
                <Border CornerRadius="14" Padding="28,24" BorderBrush="#55E5162D" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1A0B0E" Offset="0" />
                            <GradientStop Color="#FF111114" Offset="0.6" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="64" FontWeight="Bold" LineHeight="66" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource Proto.AccentWave}" Text="{Binding TweaksOn}" />
                            <TextBlock Style="{StaticResource Proto.Dim}">
                                <Run Text="tweaks on, of" /> <Run Text="{Binding TweaksAvailable, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Proto.H2}" FontSize="18" Text="{Binding Hardware}" />
                            <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,6,0,0" Text="{Binding WindowsVersion}" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource Proto.Primary}" Content="Clean up" />
                                <Button Style="{StaticResource Proto.Ghost}" Margin="10,0,0,0" Content="Check drivers" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="4" Margin="-6,14,-6,0">
                    <Border Style="{StaticResource Proto.Card}" Margin="6,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="TEMPERATURES" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding TemperatureText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Proto.Card}" Margin="6,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="RESTART" />
                            <TextBlock FontSize="14" TextWrapping="Wrap">
                                <Run Text="{Binding RestartsWaiting, Mode=OneWay}" /> <Run Text="changes waiting" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Proto.Card}" Margin="6,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="DRIVERS" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Text="1 update ready (sample)" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Proto.Card}" Margin="6,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="AFTER UPDATES" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Text="Nothing undone by Windows" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Proto.Label}" Margin="0,26,0,10" Text="NEXT STEPS" />
                <ItemsControl ItemsSource="{Binding NextSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="18,14" CornerRadius="10" Background="{StaticResource Proto.Surface}"
                                    BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Proto.Icon}" FontSize="12"
                                               Foreground="{StaticResource Proto.TextFaint}" Text="&#xE76C;" />
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{DynamicResource Proto.AccentWave}" VerticalAlignment="Center" />
                                    <TextBlock Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" Text="{Binding}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- A tweak section: a column of cards; the selected one opens up. -->
        <Grid Grid.Row="2" Visibility="{Binding IsTweakSection, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel MaxWidth="900" Margin="28,22,28,14" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource Proto.H1}" Text="{Binding PageTitle}" />
                <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,4,0,0" Text="{Binding PageSummary}" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Model.Tweaks}" SelectedItem="{Binding Model.SelectedTweak}"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource B.Card}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel MaxWidth="900" Margin="28,0,28,24" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,4,0,0">
                                        <Run Text="{Binding LabelLine, Mode=OneWay}" /> <Run Text="·" Foreground="{StaticResource Proto.TextFaint}" /> <Run Text="{Binding StateText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- Display only: the prototype never changes anything. -->
                                <CheckBox Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Proto.Switch}" IsHitTestVisible="False"
                                          IsChecked="{Binding IsOn, Mode=OneWay}" Visibility="{Binding HasSwitch, Converter={StaticResource Visible}}" />
                            </Grid>
                            <!-- The details, only in the selected card. -->
                            <StackPanel Margin="0,14,0,4"
                                        Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource Visible}}">
                                <Border Height="1" Background="{StaticResource Proto.Stroke}" Margin="0,0,0,14" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Proto.TweakChips}" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Proto.TweakDetail}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Another section. -->
        <StackPanel Grid.Row="2" MaxWidth="900" Margin="28,22,28,0" Visibility="{Binding IsOtherSection, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Proto.H1}" Text="{Binding PageTitle}" />
            <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,4,0,18" Text="{Binding PageSummary}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Proto.OtherSection}" />
        </StackPanel>
    </Grid>
</UserControl>
