<!-- PROTOTYPE, throwaway. Layout C: a slim rail of section icons, Home as a dashboard of tiles you click into,
     each section's tweaks as a dense table, and the selected tweak's details in a drawer along the bottom. -->
<UserControl x:Class="Elynt.App.Prototype.VariantC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ElyntOptimizer;component/Prototype/BlackRed.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A rail button: icon only, the section's name as a tooltip. -->
            <Style x:Key="C.RailItem" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTip" Value="{Binding Page}" />
                <Setter Property="Foreground" Value="{StaticResource Proto.TextDim}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Height="40" Margin="0,1" Background="Transparent">
                                <Border x:Name="Bg" Width="42" CornerRadius="10" />
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="1.5"
                                        Background="{DynamicResource Proto.AccentWave}" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Proto.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Proto.RedTint}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource Proto.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A table row. -->
            <Style x:Key="C.Row" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Background="Transparent">
                                <Border x:Name="Bg" BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="0,0,0,1" />
                                <Border x:Name="Bar" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Proto.AccentWave}" Visibility="Collapsed" />
                                <ContentPresenter Margin="16,9" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Proto.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Proto.Surface2}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A Home tile: a whole-tile button that opens its section. -->
            <Style x:Key="C.Tile" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource Proto.Text}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Tile" Margin="6" Padding="16,14" CornerRadius="12" Background="{StaticResource Proto.Surface}"
                                    BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Proto.Red}" />
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource Proto.Surface2}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Proto.Bg}" TextElement.Foreground="{StaticResource Proto.Text}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The rail. -->
        <Border Background="{StaticResource Proto.Surface}" BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Width="34" Height="34" Margin="0,14,0,10" CornerRadius="9" Background="{DynamicResource Proto.AccentWave}">
                    <TextBlock Text="E" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                         Margin="4,0" ItemContainerStyle="{StaticResource C.RailItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Proto.Icon}" FontSize="17" Text="{Binding Glyph}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar: where you are, a search box (not wired up in the prototype) and the connection. -->
            <Border BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="0,0,0,1" Padding="26,14,20,14">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,6" CornerRadius="14" Background="{StaticResource Proto.Surface2}"
                            VerticalAlignment="Center" ToolTip="{Binding Model.Status}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF22C55E" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Proto.TextDim}" Text="Connected" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Right" Width="260" Height="34" CornerRadius="8" Background="{StaticResource Proto.Surface}"
                            BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <TextBlock Style="{StaticResource Proto.Icon}" FontSize="13" Foreground="{StaticResource Proto.TextFaint}" Text="&#xE721;" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Proto.TextFaint}" Text="Search every tweak and tool" />
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding PageTitle}" />
                        <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,2,0,0" Text="{Binding PageSummary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Home: a dashboard of tiles; the section tiles open their section. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHome, Converter={StaticResource Visible}}">
                <StackPanel Margin="20,14,20,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Proto.Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="THIS PC" />
                                <TextBlock Style="{StaticResource Proto.H2}" Text="{Binding Hardware}" />
                                <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,4,0,14" Text="{Binding WindowsVersion}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Proto.Primary}" Content="Clean up" />
                                    <Button Style="{StaticResource Proto.Ghost}" Margin="10,0,0,0" Content="Check drivers" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Proto.Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="TWEAKS ON" />
                                <TextBlock FontSize="40" FontWeight="Bold" Foreground="{DynamicResource Proto.AccentWave}" Text="{Binding TweaksOn}" />
                                <TextBlock Style="{StaticResource Proto.Dim}">
                                    <Run Text="of" /> <Run Text="{Binding TweaksAvailable, Mode=OneWay}" /> <Run Text="that fit" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Proto.Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Proto.Label}" Margin="0,0,0,8" Text="WAITING" />
                                <TextBlock FontSize="13.5" TextWrapping="Wrap">
                                    <Run Text="{Binding RestartsWaiting, Mode=OneWay}" /> <Run Text="need a restart" />
                                </TextBlock>
                                <TextBlock FontSize="13.5" Margin="0,6,0,0" Text="1 driver update (sample)" />
                                <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,10,0,0" Text="{Binding TemperatureText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource C.Tile}" Click="OpenSection" Tag="{Binding Name}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Proto.Icon}" FontSize="11"
                                                       Foreground="{StaticResource Proto.TextFaint}" Text="&#xE76C;" />
                                            <TextBlock Style="{StaticResource Proto.Icon}" FontSize="20" HorizontalAlignment="Left"
                                                       Foreground="{StaticResource Proto.Orange}" Text="{Binding Glyph}" />
                                        </DockPanel>
                                        <TextBlock Margin="0,14,0,2" FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,0,0,10" Text="{Binding Status}" />
                                        <ProgressBar Style="{StaticResource Proto.Meter}" Value="{Binding Fraction, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- A tweak section: a table, one line per tweak. -->
            <Grid Grid.Row="1" Visibility="{Binding IsTweakSection, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12,16,0" TextElement.Foreground="{StaticResource Proto.TextFaint}" TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="16,6" Text="TWEAK" />
                    <TextBlock Grid.Column="1" Margin="0,6" Text="EVIDENCE" />
                    <TextBlock Grid.Column="2" Margin="0,6" Text="UNDO" />
                    <TextBlock Grid.Column="3" Margin="0,6" Text="STATE" />
                    <TextBlock Grid.Column="4" Margin="0,6" Text="ON" />
                </Grid>
                <ListBox Grid.Row="1" Margin="16,0,16,8" ItemsSource="{Binding Model.Tweaks}" SelectedItem="{Binding Model.SelectedTweak}"
                         Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Proto.Stroke}"
                         ItemContainerStyle="{StaticResource C.Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Proto.TextDim}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding TierText}" />
                                <TextBlock Grid.Column="2" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Proto.TextDim}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding ReversibilityText}" />
                                <TextBlock Grid.Column="3" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Proto.TextDim}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding StateText}" />
                                <!-- Display only: the prototype never changes anything. -->
                                <CheckBox Grid.Column="4" Style="{StaticResource Proto.Switch}" IsHitTestVisible="False"
                                          IsChecked="{Binding IsOn, Mode=OneWay}" Visibility="{Binding HasSwitch, Converter={StaticResource Visible}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Another section. -->
            <ContentControl Grid.Row="1" Margin="26,22,26,0" VerticalAlignment="Top" Content="{Binding}" ContentTemplate="{StaticResource Proto.OtherSection}"
                            Visibility="{Binding IsOtherSection, Converter={StaticResource Visible}}" />

            <!-- The drawer: the selected tweak's details along the bottom. Visibility reads the prototype's model. -->
            <Border Grid.Row="2" Height="290" Background="{StaticResource Proto.Surface}" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Proto.AccentWave}"
                    Visibility="{Binding HasTweakDetail, Converter={StaticResource Visible}}">
                <Grid DataContext="{Binding Model.SelectedTweak}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="26,20,16,16">
                        <TextBlock Style="{StaticResource Proto.H2}" FontSize="18" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,4,0,12" Text="{Binding StateText}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Proto.TweakChips}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Proto.Primary}" Content="Turn on" />
                            <Button Style="{StaticResource Proto.Ghost}" Margin="8,0,0,0" Content="Undo" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ContentControl Margin="24,6,28,20" Content="{Binding}" ContentTemplate="{StaticResource Proto.TweakDetail}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
