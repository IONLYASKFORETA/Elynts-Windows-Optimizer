<!-- PROTOTYPE, throwaway: the black-and-red look the three layout variants share. Colours, a few control
     templates and the tweak detail. Each variant decides its own layout. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Elynt.App.ViewModels">

    <BooleanToVisibilityConverter x:Key="Visible" />

    <SolidColorBrush x:Key="Proto.Bg" Color="#FF09090B" />
    <SolidColorBrush x:Key="Proto.Surface" Color="#FF111114" />
    <SolidColorBrush x:Key="Proto.Surface2" Color="#FF19191E" />
    <SolidColorBrush x:Key="Proto.Hover" Color="#FF1F1F26" />
    <SolidColorBrush x:Key="Proto.Stroke" Color="#FF26262D" />
    <SolidColorBrush x:Key="Proto.Text" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="Proto.TextDim" Color="#FFA1A1AA" />
    <SolidColorBrush x:Key="Proto.TextFaint" Color="#FF6B6B75" />
    <SolidColorBrush x:Key="Proto.Red" Color="#FFE5162D" />
    <SolidColorBrush x:Key="Proto.Orange" Color="#FFFF7A1A" />
    <SolidColorBrush x:Key="Proto.RedTint" Color="#1FE5162D" />
    <SolidColorBrush x:Key="Proto.OrangeTint" Color="#1AFF7A1A" />

    <LinearGradientBrush x:Key="Proto.AccentStatic" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE5162D" Offset="0" />
        <GradientStop Color="#FFFF7A1A" Offset="1" />
    </LinearGradientBrush>

    <!-- Replaced at runtime by PrototypeShell with the animated wave; this still version keeps the XAML whole. -->
    <LinearGradientBrush x:Key="Proto.AccentWave" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE5162D" Offset="0" />
        <GradientStop Color="#FFFF7A1A" Offset="0.5" />
        <GradientStop Color="#FFE5162D" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Proto.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Proto.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Proto.Text}" />
    </Style>
    <Style x:Key="Proto.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Proto.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Proto.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="#FFD4D4D8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Proto.Dim" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Proto.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Proto.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Proto.TextFaint}" />
        <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
    <Style x:Key="Proto.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Proto.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Proto.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Proto.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Proto.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="Proto.Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Proto.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Proto.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- On/off switch: red-to-orange when on. -->
    <Style x:Key="Proto.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="22" Background="Transparent">
                        <Border CornerRadius="11" Background="{StaticResource Proto.Surface2}" BorderBrush="#FF3F3F46" BorderThickness="1" />
                        <Border x:Name="Fill" CornerRadius="11" Background="{DynamicResource Proto.AccentWave}" Opacity="0" />
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#FF8A8A93" HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Proto.Primary" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="7" Background="{DynamicResource Proto.AccentWave}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Proto.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Proto.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="7" Background="{StaticResource Proto.Surface2}"
                            BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Proto.Red}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin progress line with the accent fill, for "3 of 12 on". -->
    <Style x:Key="Proto.Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="2" Background="{StaticResource Proto.Surface2}" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource Proto.AccentWave}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tweak's labels: evidence, undo and every risk, as pills. -->
    <DataTemplate x:Key="Proto.TweakChips" DataType="{x:Type vm:TweakItemViewModel}">
        <WrapPanel>
            <Border Style="{StaticResource Proto.Pill}" BorderBrush="{StaticResource Proto.Red}">
                <TextBlock Text="{Binding TierText}" FontSize="11" Foreground="{StaticResource Proto.Text}" />
            </Border>
            <Border Style="{StaticResource Proto.Pill}">
                <TextBlock Text="{Binding ReversibilityText}" FontSize="11" Foreground="{StaticResource Proto.TextDim}" />
            </Border>
            <ItemsControl ItemsSource="{Binding RiskBadges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Proto.Pill}" Background="{StaticResource Proto.OrangeTint}" BorderBrush="#66FF7A1A">
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Proto.Orange}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>
    </DataTemplate>

    <!-- The tweak's full description: warnings first, then what it does, the evidence, the exact change and undo. -->
    <DataTemplate x:Key="Proto.TweakDetail" DataType="{x:Type vm:TweakItemViewModel}">
        <StackPanel>
            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Proto.OrangeTint}"
                    BorderBrush="#55FF7A1A" BorderThickness="1"
                    Visibility="{Binding HasApplyWarning, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Proto.Body}" Text="{Binding View.ApplyWarning}" />
            </Border>
            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Proto.RedTint}"
                    BorderBrush="#66E5162D" BorderThickness="1"
                    Visibility="{Binding IsDestructive, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Proto.Body}" Text="{Binding View.DestructiveWarning}" />
            </Border>
            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Proto.OrangeTint}"
                    BorderBrush="#55FF7A1A" BorderThickness="1"
                    Visibility="{Binding HasAntiCheatWarnings, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding AntiCheatWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Proto.Body}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource Proto.Label}" Text="WHAT IT DOES" />
            <TextBlock Style="{StaticResource Proto.Body}" Text="{Binding View.WhatItDoes}" />

            <TextBlock Style="{StaticResource Proto.Label}" Text="EVIDENCE" />
            <TextBlock Style="{StaticResource Proto.Body}" Text="{Binding View.Evidence}" />
            <ItemsControl ItemsSource="{Binding View.Sources}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2" FontSize="12.5" Foreground="{StaticResource Proto.Orange}" TextWrapping="Wrap">
                            <Run Text="&#xE8A7;" FontFamily="{StaticResource Proto.IconFont}" FontSize="11" />
                            <Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Proto.Label}" Text="EXACT CHANGE" />
            <Border Padding="12,10" CornerRadius="8" Background="#FF0C0C0F" BorderBrush="{StaticResource Proto.Stroke}" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding View.ExactChange}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#FFE4E4E7"
                                       TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource Proto.Label}" Text="UNDO" />
            <TextBlock Style="{StaticResource Proto.Body}" Text="{Binding View.Undo}" />
        </StackPanel>
    </DataTemplate>

    <!-- What a section without tweaks shows in the prototype. -->
    <DataTemplate x:Key="Proto.OtherSection">
        <Border Style="{StaticResource Proto.Card}" HorizontalAlignment="Left" MaxWidth="560">
            <StackPanel>
                <TextBlock Style="{StaticResource Proto.H2}" Text="Same tools as today, in the new look" />
                <TextBlock Style="{StaticResource Proto.Dim}" Margin="0,6,0,0"
                           Text="This prototype only redraws Home and the tweak sections. Once a layout is picked, this page gets the same treatment." />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
