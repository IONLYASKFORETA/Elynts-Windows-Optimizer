<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core stays cross-platform: no Windows APIs here, only adapter interfaces. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Elynt.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NVIDIA GPU name to product-family ID map, from https://github.com/ZenitH-AT/nvidia-data (public domain, Unlicense). -->
    <EmbeddedResource Include="Drivers\nvidia-gpu-data.json" LogicalName="Elynt.Core.Drivers.nvidia-gpu-data.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>
