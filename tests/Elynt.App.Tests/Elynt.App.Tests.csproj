<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window's logic that needs no WPF, compiled in from the app by link so it runs anywhere, Linux included.
       What needs WPF is checked by the screenshot tour instead. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Elynt.App\Confirmation.cs" Link="App\Confirmation.cs" />
  </ItemGroup>

</Project>
