<Project Sdk="Microsoft.NET.Sdk">

  <!-- The window's logic that needs no WPF, compiled in from the app by link so it runs anywhere, Linux included.
       What needs WPF is checked by the screenshot tour instead. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Lets CI name a test that hangs (the Test step in ci.yml turns it on). -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Elynt.App\Confirmation.cs" Link="App\Confirmation.cs" />
    <Compile Include="..\..\src\Elynt.App\ViewModels\ObservableObject.cs" Link="App\ViewModels\ObservableObject.cs" />
    <Compile Include="..\..\src\Elynt.App\ViewModels\TweakItemViewModel.cs" Link="App\ViewModels\TweakItemViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tweak as the service sends it, which a tweak row reads. Core has no WPF either. -->
    <ProjectReference Include="..\..\src\Elynt.Core\Elynt.Core.csproj" />
  </ItemGroup>

</Project>
