<Project Sdk="Microsoft.NET.Sdk">

  <!-- Round trips against the real registry. Run on GitHub's Windows runners; skipped elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Elynt.Core\Elynt.Core.csproj" />
    <ProjectReference Include="..\..\src\Elynt.Windows\Elynt.Windows.csproj" />
  </ItemGroup>

</Project>
