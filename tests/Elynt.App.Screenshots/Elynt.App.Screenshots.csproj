<Project Sdk="Microsoft.NET.Sdk">

  <!-- Opens the real app window against an engine on the test fakes and saves a screenshot of every page, so the UI
       can be seen from CI. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the screen capture (System.Drawing). -->
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF leaves System.IO and System.Net.Http out of the implicit usings; the shared fakes expect it. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same fakes the logic tests use, so the sample PC behaves like the tested one. -->
    <Compile Include="..\Elynt.Core.Tests\**\Fake*.cs" Exclude="..\Elynt.Core.Tests\bin\**;..\Elynt.Core.Tests\obj\**"
             Link="Fakes\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The made-up PC the tour shows, kept filled by SamplePcTests. -->
    <Compile Include="..\Elynt.Core.Tests\SamplePc.cs" Link="Fakes\SamplePc.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Elynt.App\Elynt.App.csproj" />
    <ProjectReference Include="..\..\src\Elynt.Core\Elynt.Core.csproj" />
  </ItemGroup>

</Project>
